# Same checkout, separate runtime names and databases.
# Production: NODE_ENV=production, COMPOSE_PROJECT_NAME=secureinbox,
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml, COMPOSE_PROFILES=
# Set DB_URI to Atlas, FRONTEND_APP_URL to HTTPS, SEED_DEMO=false and TUNNEL_TOKEN.
NODE_ENV=development
# Native local inspection only; not forwarded to production containers.
APP_READ_ONLY=false
COMPOSE_PROJECT_NAME=secureinbox-dev
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=local-db
# Leave DB_URI empty for local MongoDB. For Atlas development use a separate
# database/user, set DB_URI, and clear COMPOSE_PROFILES to skip local MongoDB.
DB_URI=
FRONTEND_APP_URL=http://localhost:8080
PORT=5500
MONGO_PORT=27018
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
SEED_DEMO=true
TUNNEL_TOKEN=

# Local ports
APP_PORT=8080

# Local MongoDB
MONGO_DATABASE=secureinbox_dev
MONGO_ROOT_USERNAME=secureinbox_root
MONGO_ROOT_PASSWORD=replace-with-a-generated-value

# Application secrets
JWT_SECRET=replace-with-a-generated-value
JWT_EXPIRES_IN=8h
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-value

# Local demo account
DEMO_USER_NAME="Demo User"
DEMO_USER_EMAIL=demo@secureinbox.test
DEMO_USER_PASSWORD=replace-with-a-generated-value

# Local Grafana account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-generated-value

# Optional Ollama: add ai to COMPOSE_PROFILES and enable semantic analysis
# Add monitoring to COMPOSE_PROFILES to start Prometheus and Grafana.
# Local Ollama
AI_SEMANTIC_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=300000
SCAN_CONCURRENCY=1
SYNC_INTERVAL_MINUTES=15

# Optional Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/mail-accounts/google/callback
EMAIL_AUTH_RAW_FETCH_TIMEOUT_MS=10000
EMAIL_AUTH_VERIFY_TIMEOUT_MS=5000
EMAIL_AUTH_MAX_RAW_BYTES=33554432
EMAIL_AUTH_MAX_CONCURRENCY=2

# Optional Gmail push notifications (all required only when enabled)
GMAIL_PUSH_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT_EMAIL=
GMAIL_POLL_INTERVAL_WITH_PUSH=60

# Optional threat intelligence (disabled unless explicitly enabled)
THREAT_INTEL_ENABLED=false
WEB_RISK_API_KEY=
URLHAUS_AUTH_KEY=
THREAT_INTEL_MAX_URLS_PER_EMAIL=5
THREAT_INTEL_TIMEOUT_MS=10000

# Optional attachment verification (disabled unless explicitly enabled)
ATTACHMENT_ANALYSIS_ENABLED=false
ATTACHMENT_ANALYSIS_CONCURRENCY=3
ATTACHMENT_ANALYSIS_TIMEOUT_MS=15000

# Optional email delivery
EMAIL_FROM=
EMAIL_PASSWORD=
SUPPORT_EMAIL=

# Optional Arcjet protection
ARCJET_KEY=
ARCJET_ENV=development
